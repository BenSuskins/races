  "factors": [
    {
      "id": "officialRating",
      "label": "Official rating",
      "summary": "The handicapper's number. The strongest thing the free tier gives us."
    },
    {
      "id": "handicapBandPosition",
      "label": "Position in the handicap",
      "summary": "Where the rating sits inside the race's own band — well in at the top, struggling at the bottom."
    },
    {
      "id": "recentForm",
      "label": "Recent form",
      "summary": "The form string, read right to left and weighted toward the most recent run."
    },
    {
      "id": "wonLastTime",
      "label": "Won last time out",
      "summary": "Whether the last completed run was a win."
    },
    {
      "id": "completionRate",
      "label": "Completion record",
      "summary": "How often the horse finishes at all. It means far more over fences than on the Flat."
    },
    {
      "id": "daysSinceLastRun",
      "label": "Days since last run",
      "summary": "Time off, scored as a bell rather than a line — a fortnight is better than three days or three months."
    },
    {
      "id": "age",
      "label": "Age",
      "summary": "Age against the race's own age band."
    },
    {
      "id": "weightCarried",
      "label": "Weight carried",
      "summary": "Pounds carried, negated so less is better.",
      "rationale": "Near zero on purpose: in a handicap, weight is the handicapper's equaliser, so it substantially double-counts the official rating."
    },
    {
      "id": "draw",
      "label": "Draw",
      "summary": "Stall number.",
      "rationale": "Draw bias is real, but it is a course × distance × going × field-size interaction. Without a bias table it is noise, so the code ships switched off."
    },
    {
      "id": "headgear",
      "label": "Headgear",
      "summary": "Blinkers, a visor, a hood, cheekpieces.",
      "rationale": "The signal is *first-time* headgear, and the free tier has no headgear history to detect it with."
    },
    {
      "id": "jockeyStrikeRate",
      "label": "Jockey strike rate",
      "summary": "The jockey's win rate in the server's own archive, shrunk toward the field average.",
      "rationale": "Legitimate, but derived from an archive that starts empty. It switches on once enough race days have been collected."
    },
    {
      "id": "trainerStrikeRate",
      "label": "Trainer strike rate",
      "summary": "The trainer's win rate in the server's own archive, shrunk toward the field average.",
      "rationale": "Legitimate, but derived from an archive that starts empty. It switches on once enough race days have been collected."
    },
    {
      "id": "jockeySurfaceStrikeRate",
      "label": "Jockey strike rate by surface",
      "summary": "The jockey's win rate on this surface, shrunk toward the jockey's overall record.",
      "rationale": "Surface cells need at least 30 runs. The default weight is zero until walk-forward replay supports it."
    },
    {
