<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export-compliance declaration, answered here so TestFlight does not ask
	     per build. `false` means "uses no non-exempt encryption": the app's only
	     cryptography is ATS/TLS for the two provider APIs and the Keychain for
	     the user's credentials, both supplied by the operating system. It
	     implements none of its own and ships none.

	     Without this key every upload sits at "Missing Compliance" in App Store
	     Connect until the questionnaire is answered by hand. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Background results collection. The free results endpoint covers today
	     only, so a race day the app never runs on is a day of results lost for
	     good — along with the jockey and trainer records that accumulate from
	     them. `fetch` is what lets the app pick them up in the evening without
	     being opened. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>

	<!-- Must list every identifier passed to BGTaskScheduler.register.
	     Registering an identifier absent from this array traps at launch, so
	     this array and `BackgroundRefresh.taskIdentifier` have to agree
	     exactly. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>uk.co.suskins.Races.refresh</string>
	</array>
</dict>
</plist>
