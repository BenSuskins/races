<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export-compliance declaration, answered here so TestFlight does not ask
	     per build. `false` means "uses no non-exempt encryption": the app's only
	     cryptography is ATS/TLS to the Races server and the Keychain for its
	     API token, both supplied by the operating system. It implements none of
	     its own and ships none.

	     Without this key every upload sits at "Missing Compliance" in App Store
	     Connect until the questionnaire is answered by hand. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- No background modes. Results collection used to need `fetch`, because
	     the free results endpoint is today-only and a phone asleep all evening
	     lost the day. The server polls it all evening now, so the app has
	     nothing to do in the background. -->
</dict>
</plist>
