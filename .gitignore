# macOS
.DS_Store

# Xcode
ios/build/
ios/DerivedData/
ios/**/*.xcodeproj/xcuserdata/
ios/**/*.xcodeproj/project.xcworkspace/xcuserdata/
ios/**/*.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Test output
ios-test-results/
*.xcresult

# Claude local config (may contain secrets)
.claude/
.worktrees/

# Never commit provider credentials. The app takes them from Settings at runtime
# and stores them in the Keychain — nothing belongs in the repo.
*.credentials
Secrets.plist
Config.plist

# Python bytecode from scripts/
__pycache__/
*.pyc

# Captured provider payloads. The corpus grows daily and is for the back-test,
# not the repo; committed fixtures are a chosen handful under the kit's tests.
capture/

# Capture credentials, read by scripts/capture-fixtures.py
scripts/.capture-env
